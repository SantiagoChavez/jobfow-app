# URL base de la API del backend en producción (ej. Render)
# En desarrollo local: dejar vacío o comentar para usar el proxy automático de Vite (/api -> http://localhost:5000)
# En producción (Vercel): configurar en Settings -> Environment Variables con el dominio de Render:
# VITE_API_URL=https://jobflow-api.onrender.com
VITE_API_URL=

# ID de cliente para Google OAuth (Google Identity Services)
# Obténlo en Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=
